@page "/analytics"
@using RealEstateAgency.WebApplication.Api
@using System.Globalization

@inject RealEstateAgencyApiWrapper ApiWrapper

<PageTitle>
    Real Estate Analytics
</PageTitle>

<h3 class="mb-4">
    Real Estate Analytics
</h3>

@if (isLoading)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Download...</span>
        </div>
    </div>
}
else
{
    <div class="container-fluid">
        <div class="card mb-4">
            <div class="card-header">
                <h5>
                    Clients by Property Type
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label for="realEstateType" class="form-label">
                            Property type:
                        </label>
                        <select id="realEstateType" class="form-select" @onchange="OnRealEstateTypeChanged">
                            <option value="">
                                --Select Type--
                            </option>
                            @foreach (var type in realEstateTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                </div>

                @if (_clientsByType != null && _clientsByType.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>FIO</th>
                                    <th>Pasport</th>
                                    <th>Phone</th>
                                    <th>Address</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var client in _clientsByType)
                                {
                                    <tr>
                                        <td>@client.FirstAndLastName</td>
                                        <td>@client.Pasport</td>
                                        <td>@client.NumberPhone</td>
                                        <td>@client.Address</td>
                                        <td>@client.Email</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (!string.IsNullOrEmpty(_selectedRealEstateType))
                {
                    <p class="text-muted">
                        There is no data available for the selected property type.
                    </p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>
                    Sellers for the Period
                </h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Start Data:</label>
                        <InputDate class="form-control" @bind-Value="startDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">End Data:</label>
                        <InputDate class="form-control" @bind-Value="endDate" />
                    </div>
                    <div class="col-md-3 align-self-end">
                        <button class="btn btn-primary" @onclick="LoadSellersByPeriod">Download</button>
                    </div>
                </div>

                @if (_sellersByPeriod != null && _sellersByPeriod.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>FIO</th>
                                    <th>Pasport</th>
                                    <th>Phone</th>
                                    <th>Address</th>
                                    <th>Email</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var seller in _sellersByPeriod)
                                {
                                    <tr>
                                        <td>@seller.FirstAndLastName</td>
                                        <td>@seller.Pasport</td>
                                        <td>@seller.NumberPhone</td>
                                        <td>@seller.Address</td>
                                        <td>@seller.Email</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (_sellersByPeriod != null)
                {
                    <p class="text-muted">
                        There are no sellers for the specified period.
                    </p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Relevant Sellers for Buyer</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label for="buyerSelect" class="form-label">Buyer:</label>
                        <select id="buyerSelect" class="form-select" @onchange="OnBuyerSelected">
                            <option value="">
                                --Select Buyer--
                            </option>
                            @foreach (var client in allClients)
                            {
                                <option value="@client.Id">@client.FirstAndLastName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2 align-self-end">
                        <button class="btn btn-primary" @onclick="LoadMatchingSellers" disabled="@(!CanLoadMatchingSellers)">
                            Download
                        </button>
                    </div>
                </div>

                @if (_matchingSellers != null)
                {
                    <div class="mb-3">
                        <h6>
                            Real estate:
                        </h6>
                        <ul class="list-group">
                            <li class="list-group-item"><strong>Type:</strong> @_matchingSellers.RealEstate.Type</li>
                            <li class="list-group-item"><strong>Square:</strong> @_matchingSellers.RealEstate.Square м²</li>
                            <li class="list-group-item"><strong>Number of rooms:</strong> @_matchingSellers.RealEstate.NumberOfRooms</li>
                            <li class="list-group-item"><strong>Address:</strong> @_matchingSellers.RealEstate.Address</li>
                        </ul>
                    </div>

                    <div>
                        <h6>Sellers:</h6>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th>FIO</th>
                                        <th>Pasport</th>
                                        <th>Phone</th>
                                        <th>Address</th>
                                        <th>Email</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var seller in _matchingSellers.Sellers)
                                    {
                                        <tr>
                                            <td>@seller.FirstAndLastName</td>
                                            <td>@seller.Pasport</td>
                                            <td>@seller.NumberPhone</td>
                                            <td>@seller.Address</td>
                                            <td>@seller.Email</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else if (buyerId > 0)
                {
                    <p class="text-muted">
                        There are no matching sellers for the specified buyer.
                    </p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>
                    Number of Orders by Type
                </h5>
            </div>
            <div class="card-body">
                @if (_orderCountByType != null && _orderCountByType.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>
                                        Property Type
                                    </th>
                                    <th>
                                        Number of Orders
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in _orderCountByType)
                                {
                                    <tr>
                                        <td>@item.RealEstateType</td>
                                        <td>@item.OrderCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">
                        There is no data on orders by property type.
                    </p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>
                    Top Buyers
                </h5>
            </div>
            <div class="card-body">
                @if (_topPurchasers != null && _topPurchasers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Client</th>
                                    <th>
                                        Number of Orders
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var purchaser in _topPurchasers)
                                {
                                    <tr>
                                        <td>@purchaser.Client.FirstAndLastName</td>
                                        <td>@purchaser.OrderCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No data on top buyers.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>
                    Top Sellers
                </h5>
            </div>
            <div class="card-body">
                @if (_topSellers != null && _topSellers.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Client</th>
                                    <th>
                                        Number of Orders
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var seller in _topSellers)
                                {
                                    <tr>
                                        <td>@seller.Client.FirstAndLastName</td>
                                        <td>@seller.OrderCount</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No data on top sellers.</p>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Orders with Minimum Price</h5>
            </div>
            <div class="card-body">
                @if (_minPriceOrders != null && _minPriceOrders.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Client</th>
                                    <th>Order Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in _minPriceOrders)
                                {
                                    <tr>
                                        <td>@order.Client.FirstAndLastName</td>
                                        <td>@order.OrderPrice.ToString("C", CultureInfo.CurrentCulture)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">There are no orders with a minimum price.</p>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool isLoading = true;

    private IList<ClientDto>? _clientsByType;
    private string? _selectedRealEstateType;
    private List<string> realEstateTypes = new List<string> { "Residential", "Uninhabitable" };

    private IList<ClientDto>? _sellersByPeriod;
    private DateTime startDate = DateTime.Today.AddMonths(-1);
    private DateTime endDate = DateTime.Today;

    private SellerRealEstateDto? _matchingSellers;
    private int buyerId;
    private IList<ClientGetDto> allClients = new List<ClientGetDto>();
    private IList<RealEstateOrderCountDto>? _orderCountByType;
    private IList<ClientOrderCountDto>? _topPurchasers;
    private IList<ClientOrderCountDto>? _topSellers;
    private IList<ClientOrderPriceDto>? _minPriceOrders;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllData();
        isLoading = false;
    }

    private async Task LoadAllData()
    {
        allClients = await ApiWrapper.GetClients();

        if (!string.IsNullOrEmpty(_selectedRealEstateType))
        {
            _clientsByType = await ApiWrapper.ClientsByRealestateTypeAsync(_selectedRealEstateType);
        }

        _orderCountByType = await ApiWrapper.OrderCountByTypeAsync();

        _topPurchasers = await ApiWrapper.TopPurchasersAsync();

        _topSellers = await ApiWrapper.TopSellersAsync();

        _minPriceOrders = await ApiWrapper.MinPriceOrdersAsync();
    }

    private async Task OnRealEstateTypeChanged(ChangeEventArgs e)
    {
        _selectedRealEstateType = e.Value?.ToString() ?? string.Empty;
        if (!string.IsNullOrEmpty(_selectedRealEstateType))
        {
            _clientsByType = await ApiWrapper.ClientsByRealestateTypeAsync(_selectedRealEstateType);
        }
    }

    private async Task LoadSellersByPeriod()
    {
        if (startDate <= endDate)
        {
            _sellersByPeriod = await ApiWrapper.SellersByPeriodAsync(startDate, endDate);
        }
        else
        {
            _sellersByPeriod = new List<ClientDto>();
        }
    }

    private async Task LoadMatchingSellers()
    {
        if (buyerId > 0)
        {
            _matchingSellers = await ApiWrapper.MatchingSellersForBuyerAsync(buyerId);
        }
 
    }

    private void OnBuyerSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selectedId))
        {
            buyerId = selectedId;
        }
        else
        {
            buyerId = 0;
        }
    }

    private bool CanLoadMatchingSellers => buyerId > 0;
}
